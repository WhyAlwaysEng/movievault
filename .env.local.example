# ── Firebase Auth (login only — DB is self-hosted SQLite) ───────────────────
# Copy this file to .env.local and fill in values from Firebase Console.
# Without these, the app runs in Owner Mode (single-user, no login, full admin).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server-side secrets (BFF route handlers — NEVER NEXT_PUBLIC_) ─────────
# TMDB API key (free — https://www.themoviedb.org/settings/api) for library search & save
TMDB_API_KEY=

# ── Self-hosted runtime ──────────────────────────────────────────────────────
# Where the SQLite DB and downloaded media/actress files live (default: <project>/data)
DATA_DIR=

# Emails granted admin on first login (comma-separated) when Firebase auth is on
ADMIN_EMAILS=

# Optional JAV provider adapter base URL (see lib/providers/jav.ts)
JAV_API_BASE=

# ── Observability (optional) ────────────────────────────────────────────────
SENTRY_DSN=
