# MovieVault Environment Variables
# Port (optional, defaults to 3000)
PORT=3000

# Custom path to SQLite database and media files (default: ./data)
# On Orange Pi with external storage, e.g.: DATA_DIR=/mnt/storage/movievault/data
DATA_DIR=

# TMDB API Key for metadata scraping (Movies & Series)
TMDB_API_KEY=

# qBittorrent WebUI integration (Optional, running on Orange Pi)
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

